; Pin dependency versions exactly when adding/updating via npm install.
save-exact=true

; Enforce HTTPS and refuse to continue on TLS/registry errors.
strict-ssl=true

; Fail builds on known-vulnerable resolutions.
audit-level=high

; Do not execute arbitrary install lifecycle scripts from dependencies.
ignore-scripts=true

; Use the public registry explicitly; replace with an internal, write-restricted
; mirror in CI/deploy.
registry=https://registry.npmjs.org/
